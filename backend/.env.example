PORT=4010
# 127.0.0.1 en local; usa 0.0.0.0 solo si tu hosting lo necesita.
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
# Acceso al panel /admin: tu correo y una contraseña de 12+ caracteres. Sin ellos el panel queda desactivado.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Si corres detrás de un proxy/hosting, número de saltos de proxy a confiar (p. ej. 1).
TRUST_PROXY=
# Máximo de contactos guardados en data/leads.json
MAX_LEADS=5000
